# ---- build stage: install deps into a venv ----
FROM python:3.12-slim AS builder
WORKDIR /app
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ---- runtime stage: small, non-root ----
FROM python:3.12-slim
RUN useradd --create-home --uid 10001 finsight
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    FINSIGHT_CHROMA_DIR=/app/storage/chroma \
    FINSIGHT_CACHE_DB=/app/storage/semantic_cache.sqlite \
    FINSIGHT_DATA_DIR=/app/data \
    FINSIGHT_EMBED_CACHE_DIR=/opt/models
# Bake the embedding model into the image so pods need no download at runtime
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5', cache_dir='/opt/models')" && chmod -R a+rX /opt/models
COPY finsight ./finsight
COPY scripts ./scripts
COPY evaluation ./evaluation
COPY data/sample ./data/sample
RUN mkdir -p /app/storage /app/data/uploads && chown -R finsight:finsight /app
USER finsight
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"
CMD ["uvicorn", "finsight.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
