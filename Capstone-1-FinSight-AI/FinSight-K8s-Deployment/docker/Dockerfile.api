# FinSight FastAPI image. Build from the repository root:
# docker build -f docker/Dockerfile.api -t finsight-api:<tag> .
FROM python:3.12-slim AS builder
WORKDIR /build
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

FROM python:3.12-slim AS runtime
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    FINSIGHT_CHROMA_DIR=/app/storage/chroma \
    FINSIGHT_CACHE_DB=/app/storage/semantic_cache.sqlite \
    FINSIGHT_DATA_DIR=/app/data
RUN groupadd --gid 10001 finsight \
    && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin finsight \
    && mkdir -p /app/storage /app/data/uploads /tmp/finsight \
    && chown -R 10001:10001 /app /tmp/finsight
WORKDIR /app
COPY --from=builder /opt/venv /opt/venv
COPY --chown=10001:10001 finsight ./finsight
COPY --chown=10001:10001 scripts ./scripts
COPY --chown=10001:10001 evaluation ./evaluation
COPY --chown=10001:10001 data/sample ./data/sample
USER 10001:10001
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)" || exit 1
CMD ["uvicorn", "finsight.api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
