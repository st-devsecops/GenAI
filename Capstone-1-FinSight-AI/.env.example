# Copy to .env and adjust. Everything here is free.

# Groq is used for chat; get a free API key at https://console.groq.com.
FINSIGHT_SMALL_PROVIDER=groq
FINSIGHT_SMALL_MODEL=openai/gpt-oss-20b
FINSIGHT_STRONG_PROVIDER=groq
FINSIGHT_STRONG_MODEL=openai/gpt-oss-120b
FINSIGHT_GROQ_API_KEY=gsk_...

# Optional local Ollama chat configuration.
FINSIGHT_OLLAMA_URL=http://localhost:11434
# Ollama as seen from inside Docker Compose (default works on Mac/Windows Docker Desktop).
# Linux without Docker Desktop: use http://172.17.0.1:11434. Bundled ollama profile: http://ollama:11434
DOCKER_OLLAMA_URL=http://host.docker.internal:11434
# For local Ollama: set both chat providers to ollama and choose the installed models.
FINSIGHT_EMBED_PROVIDER=fastembed
FINSIGHT_EMBED_MODEL=BAAI/bge-small-en-v1.5

FINSIGHT_RERANKER_ENABLED=true
FINSIGHT_CACHE_ENABLED=true
FINSIGHT_CACHE_THRESHOLD=0.95

# Leave empty for local dev; set a value to require the X-API-Key header
FINSIGHT_API_KEY=
